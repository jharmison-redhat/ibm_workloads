# Configure IBM Cloud Provider
terraform {
  required_providers {
    ibm = {
      source  = "IBM-Cloud/ibm"
      version = "~> {{ ibmcloud_provider_version }}"
    }
  }
}

# Configure IBM Cloud Provider
provider "ibm" {
  ibmcloud_api_key = var.ibmcloud_api_key
  region           = var.ibm_region_location
}

# Variables
variable "ibmcloud_api_key" {
  description = "IBM Cloud API Key. Must already have access to the target resource group and the Cloud Object Storage service."
  type        = string
  sensitive   = true
}

variable "ibm_region_location" {
  description = "IBM Cloud region"
  type        = string
  default     = "us-east"
}

variable "ibmcloud_resource_group_name" {
  description = "Name of the existing IBM Cloud resource group to deploy resources into. The ibmcloud_api_key must already have access to this resource group."
  type        = string
}

variable "guid" {
  description = "Unique deployment identifier"
  type        = string
  default     = "{{ guid }}"
}

# Local values for naming consistency
locals {
  name_prefix     = "{{ ibmcloud_terraform_name_prefix }}"

  # Use GUID for resource naming
  deployment_id   = var.guid

  # Service configuration
  instructlab_service = "{{ ibmcloud_instructlab_instance_service }}"
  instructlab_plan    = "{{ ibmcloud_instructlab_instance_plan }}"

  # Storage configuration
  storage_class = "{{ ibmcloud_storage_class }}"

  # Resource names - instructlab-{guid}-{type} pattern
  cos_instance_name = "${local.name_prefix}-${local.deployment_id}-cos"
  cos_bucket_name = "${local.name_prefix}-${local.deployment_id}-bucket-${formatdate("YYYYMMDDHHMM", timestamp())}"
  instructlab_instance_name = "${local.name_prefix}-${local.deployment_id}-il"

  # Common tags
  tags = [
    "agnosticd",
    "instructlab",
    "guid:${var.guid}",
    "deployment_id:${local.deployment_id}",
    "managed_by:terraform"
  ]
}

# Look up the existing resource group. The ibmcloud_api_key used by the
# provider is expected to already have access to this resource group and
# to the Cloud Object Storage service, so no resource group, trusted
# profile, or IAM policy needs to be created by this configuration.
data "ibm_resource_group" "instructlab_resource_group" {
  name = var.ibmcloud_resource_group_name
}

locals {
  resource_group_id = data.ibm_resource_group.instructlab_resource_group.id
}

## Create Cloud Object Storage instance
resource "ibm_resource_instance" "instructlab_cos_instance" {
  name              = local.cos_instance_name
  service           = "cloud-object-storage"
  plan              = "standard"
  location          = "global"
  resource_group_id = local.resource_group_id
  tags              = local.tags

  timeouts {
    create = "15m"
    update = "15m"
    delete = "15m"
  }
}

## Create COS bucket
resource "ibm_cos_bucket" "instructlab_bucket" {
  bucket_name          = local.cos_bucket_name
  resource_instance_id = ibm_resource_instance.instructlab_cos_instance.id
  region_location      = var.ibm_region_location
  storage_class        = local.storage_class

  depends_on = [ibm_resource_instance.instructlab_cos_instance]
}

## Create InstructLab service instance
resource "ibm_resource_instance" "instructlab_instance" {
  name              = local.instructlab_instance_name
  service           = local.instructlab_service
  plan              = local.instructlab_plan
  location          = var.ibm_region_location
  resource_group_id = local.resource_group_id
  tags              = local.tags

  timeouts {
    create = "15m"
    update = "15m"
    delete = "15m"
  }
}

# Create authorization policy for InstructLab service to access COS
# This allows the InstructLab service to access the COS instance with Writer permissions.
# This is a service-to-service policy and is required regardless of which
# identity (API key, trusted profile, user) provisioned the resources.
resource "ibm_iam_authorization_policy" "instructlab_cos_auth" {
  source_service_name         = local.instructlab_service
  source_resource_instance_id = ibm_resource_instance.instructlab_instance.guid
  target_service_name         = "cloud-object-storage"
  target_resource_instance_id = ibm_resource_instance.instructlab_cos_instance.guid
  roles                       = ["Writer"]

  depends_on = [
    ibm_resource_instance.instructlab_instance,
    ibm_resource_instance.instructlab_cos_instance
  ]
}

# Outputs
output "resource_group_id" {
  description = "ID of the existing resource group used for the deployment"
  value       = local.resource_group_id
}

output "resource_group_name" {
  description = "Name of the existing resource group used for the deployment"
  value       = data.ibm_resource_group.instructlab_resource_group.name
}

output "cos_instance_id" {
  description = "ID of the COS instance"
  value       = ibm_resource_instance.instructlab_cos_instance.id
}

output "cos_instance_guid" {
  description = "GUID of the COS instance"
  value       = ibm_resource_instance.instructlab_cos_instance.guid
}

output "cos_bucket_name" {
  description = "Name of the COS bucket"
  value       = ibm_cos_bucket.instructlab_bucket.bucket_name
}

output "instructlab_instance_id" {
  description = "ID of the InstructLab service instance"
  value       = ibm_resource_instance.instructlab_instance.id
}

output "instructlab_instance_guid" {
  description = "GUID of the InstructLab service instance"
  value       = ibm_resource_instance.instructlab_instance.guid
}

output "instructlab_instance_name" {
  description = "Name of the InstructLab service instance"
  value       = ibm_resource_instance.instructlab_instance.name
}

output "instructlab_direct_url" {
  description = "Direct URL to access the InstructLab project (bypasses service listing for security)"
  value       = "https://cloud.ibm.com${ibm_resource_instance.instructlab_instance.dashboard_url}"
}

output "deployment_summary" {
  description = "Summary of deployed resources"
  value = {
    region              = var.ibm_region_location
    guid                = var.guid
    resource_group      = data.ibm_resource_group.instructlab_resource_group.name
    cos_instance        = ibm_resource_instance.instructlab_cos_instance.name
    cos_bucket          = ibm_cos_bucket.instructlab_bucket.bucket_name
    instructlab_service = ibm_resource_instance.instructlab_instance.name
    service_type        = local.instructlab_service
    service_plan        = local.instructlab_plan
  }
}
